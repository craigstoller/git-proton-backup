TestResults/
testResults.xml

# Agent permission allowlists. Tools such as Claude Code record each approved
# command verbatim, so any secret pasted on a command line -- a token, an API
# key, a connection string -- is stored in this file in plain text. Treat it
# like .env and never commit it.
**/.claude/settings.local.json

# git-remote-proton build output
/git-remote-proton
/git-remote-proton.exe

# Agent working files: certification captures, SDD ledgers and review packages.
# They are scratch, never source of truth (AGENTS.md), and some hold raw account
# listings, so they stay out of this public repository.
.superpowers/
